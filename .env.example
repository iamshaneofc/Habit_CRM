# ========================================================
# HABIT CRM - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode: development | production
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1

# ========================================================
# DATABASE CONFIGURATION
# ========================================================
# By default, Habit CRM uses local SQLite (zero setup required).
# When you are ready to test AWS RDS, set DB_TYPE=postgres or DB_TYPE=mysql
# and fill in your AWS RDS endpoint details below.

DB_TYPE=sqlite

# Local SQLite (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=habits.db

# AWS RDS PostgreSQL / MySQL Settings (used when DB_TYPE=postgres or DB_TYPE=mysql)
RDS_HOSTNAME=your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=habit_crm_db
RDS_USERNAME=postgres
RDS_PASSWORD=your_secure_rds_password

# Or provide direct SQLAlchemy connection URL (overrides individual RDS fields if set):
# Example AWS RDS PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com:5432/habit_crm_db
# Example AWS RDS MySQL:
# DATABASE_URL=mysql+pymysql://admin:your_password@your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com:3306/habit_crm_db
DATABASE_URL=
